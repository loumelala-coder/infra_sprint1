# === KITTYGRAM: HTTPS ===
server {
    listen 443 ssl;
    server_name loumelala-kittygram.duckdns.org;
    client_max_body_size 20M;

    ssl_certificate /etc/letsencrypt/live/loumelala-kittygram.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/loumelala-kittygram.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        root /var/www/kittygram;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /static_backend/ {
        alias /var/www/kittygram/static_backend/;
    }

    location /media/ {
        alias /var/www/kittygram/media/;
    }
}

server {
    listen 80;
    server_name loumelala-kittygram.duckdns.org;
    return 301 https://$host$request_uri;
}

# === TASKI: HTTPS ===
server {
    listen 443 ssl;
    server_name loumelala-taski.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/loumelala-taski.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/loumelala-taski.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name loumelala-taski.duckdns.org;
    return 301 https://$host$request_uri;
}
